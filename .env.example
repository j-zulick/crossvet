# Crossvet: copy this file to .env in the folder you run Crossvet from, and fill in the keys you have.
# Every key is optional; set at least one provider. Routing settings live in crossvet-chat.toml
# (copy crossvet-chat.example.toml). Guide: docs/CHAT.md

# --- Model providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google Gemini
GOOGLE_API_KEY=
# xAI Grok
XAI_API_KEY=
# One key for most other vendors (DeepSeek, Mistral, Meta, Qwen...), and for Jev and OpenRouter's routers
OPENROUTER_API_KEY=

# --- Models on your own machine (optional) ---
# Ollama: use "ollama:<model>" in the settings (default address http://localhost:11434/v1)
OLLAMA_BASE_URL=
# Any OpenAI-compatible server (LM Studio, llama.cpp, MLX, vLLM): use "local:<model>" in the settings
LOCAL_BASE_URL=
LOCAL_API_KEY=

# --- Langfuse: a copy of every turn and rating, with cost (optional; install crossvet[langfuse]) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# https://us.cloud.langfuse.com, https://cloud.langfuse.com or your own server
LANGFUSE_BASE_URL=

# --- Crossvet chat ---
# Settings file (empty = ./crossvet-chat.toml, else ~/.config/crossvet/chat.toml)
CROSSVET_CHAT_CONFIG=
# The chat store: every turn, rating and note (empty = ~/.local/share/crossvet/chat.db)
CROSSVET_CHAT_DB=
# Token `crossvet chat serve` requires (sent only as Authorization: Bearer); needed to listen on any address
# but this machine, at least 16 characters there
CROSSVET_CHAT_TOKEN=
# Override [router] use for every request: rules, jev, openrouter-auto, openrouter-auto-code or jev-router
CROSSVET_CHAT_ROUTER=
# 0 turns off prompt-cache markers on long system text sent to Anthropic (default on)
CROSSVET_CHAT_CACHE=

# --- Rarely needed ---
# OPENROUTER_APP_TITLE=Crossvet                       (app name sent to OpenRouter)
# OPENROUTER_APP_URL=https://github.com/j-zulick/crossvet
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   (OpenTelemetry spans; install crossvet[otel])
