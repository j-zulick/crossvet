# --- Model providers (set the ones you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Optional: one key for many models; use "openrouter:<model>" in REVIEW_MODELS
OPENROUTER_API_KEY=

# --- Self-hosted models (optional) ---
# Ollama: use "ollama:<model>" anywhere a model is set (e.g. RESEARCH_MODEL=ollama:gemma3)
# Any OpenAI-compatible server (llama.cpp, LM Studio, MLX, vLLM): "local:<model>" in REVIEW_MODELS
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_API_KEY=not-needed

# --- Search ---
# gateway (self-hosted research gateway over MCP), tavily (needs TAVILY_API_KEY),
# openai / anthropic (model-native web search), or none
SEARCH_API=tavily
TAVILY_API_KEY=
RESEARCH_GATEWAY_URL=https://your-gateway.example.com/research/mcp
RESEARCH_GATEWAY_TOKEN=
# Optional: also give researchers a model's built-in search next to SEARCH_API (openai | anthropic)
SEARCH_ALSO=
# RESEARCH_GATEWAY_TOOL=search_and_read

# --- Cross-vendor review ---
CROSS_VENDOR_REVIEW_ENABLED=true
# At least two, ideally from different vendors. `uv run crossvet-setup` fills these from the
# models your keys can actually use (model names change; retired names fail at run time).
REVIEW_MODELS=openai:gpt-5.5,anthropic:claude-sonnet-5-5
# with a self-hosted reviewer: ...,ollama:gemma3  or  ...,local:<model-name>
# Model that revises the report after review; pick a vendor NOT on the panel
# (defaults to FINAL_REPORT_MODEL; a warning is added if it shares a vendor with a reviewer)
REVIEW_REVISER_MODEL=
# Independent critic checks findings against the research notes before the vote
REVIEW_CRITIC_ENABLED=true
# Deliberation rounds before voting (0 = off, max 3): rotating challengers, grounded position changes only
REVIEW_DELIBERATION_ROUNDS=0
# Early stopping (v1.1): stop on consensus or a stable disagreement, decided in code
REVIEW_DELIBERATION_EARLY_STOP=true
REVIEW_CONSENSUS_THRESHOLD=1.0
REVIEW_DELIBERATION_MIN_ROUNDS=1
REVIEW_CONSENSUS_MIN_GROUNDED_SHARE=0.5
# Optional: append each reviewed run as JSONL (for evals / fine-tuning)
RUN_EXPORT_PATH=

# --- Human approval before the final report ---
REQUIRE_APPROVAL=false

# --- Durable runs (CLI) ---
# Default: local SQLite at .crossvet/checkpoints.sqlite
# CROSSVET_CHECKPOINTS=.crossvet/checkpoints.sqlite
# DATABASE_URL=postgresql://user:pass@localhost:5432/crossvet   (uv sync --extra postgres)

# --- Langfuse tracing with cost per model (CLI runs) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   (or your self-hosted URL)

# --- Optional tracing (upstream) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=false

# --- Only for Open Agent Platform deployments (upstream) ---
SUPABASE_KEY=
SUPABASE_URL=
GET_API_KEYS_FROM_CONFIG=false
