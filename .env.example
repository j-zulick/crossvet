# --- Model providers (set the ones you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Optional: one key for many models; use "openrouter:<maker>/<model>" anywhere a model is set
OPENROUTER_API_KEY=

# --- Self-hosted models (optional) ---
# Ollama: use "ollama:<model>" anywhere a model is set (e.g. RESEARCH_MODEL=ollama:gemma3)
# Any OpenAI-compatible server (llama.cpp, LM Studio, MLX, vLLM): "local:<model>" anywhere a model is set
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_API_KEY=not-needed

# --- Models per role (optional; empty = the research model) ---
# Orchestration: plans sub-questions, delegates them, decides when research is done (needs tool calls)
SUPERVISOR_MODEL=
# Research: searches and reads sources for each sub-question (needs tool calls)
RESEARCHER_MODEL=
# `uv run crossvet-bench` measures which model is best and cheapest for each role, and
# `uv run crossvet-bench apply --preset best-value` writes the winners here.

# --- Research pipeline (empty = the default shown) ---
# Models for each step; `uv run crossvet-bench apply` can write the measured winners here
RESEARCH_MODEL=
# default openai:gpt-6.1-sol
SUMMARIZATION_MODEL=
# default openai:gpt-6-luna
COMPRESSION_MODEL=
# default openai:gpt-6-luna
FINAL_REPORT_MODEL=
# default openai:gpt-6-luna
# Output token limits per step (defaults: research 10000, summarization 8192, compression 8192,
# final report 10000, each reviewer 8000)
RESEARCH_MODEL_MAX_TOKENS=
SUMMARIZATION_MODEL_MAX_TOKENS=
COMPRESSION_MODEL_MAX_TOKENS=
FINAL_REPORT_MODEL_MAX_TOKENS=
REVIEW_MODEL_MAX_TOKENS=
# How much research runs (defaults: 5 parallel sub-questions, 6 supervisor iterations,
# 10 tool calls per researcher, 3 retries for structured output, 50000 characters per page)
MAX_CONCURRENT_RESEARCH_UNITS=
MAX_RESEARCHER_ITERATIONS=
MAX_REACT_TOOL_CALLS=
MAX_STRUCTURED_OUTPUT_RETRIES=
MAX_CONTENT_LENGTH=
# Ask a clarifying question before researching when the request is ambiguous (default true)
ALLOW_CLARIFICATION=
# Extra MCP tools for researchers: a JSON server configuration and instructions for using it
MCP_CONFIG=
MCP_PROMPT=

# --- Search ---
# gateway (self-hosted research gateway over MCP), tavily (needs TAVILY_API_KEY),
# openai / anthropic (model-native web search), or none
SEARCH_API=tavily
TAVILY_API_KEY=
RESEARCH_GATEWAY_URL=https://your-gateway.example.com/research/mcp
RESEARCH_GATEWAY_TOKEN=
# Optional: also give researchers a model's built-in search next to SEARCH_API (openai | anthropic)
SEARCH_ALSO=
# RESEARCH_GATEWAY_TOOL=search_and_read

# --- Cross-vendor review ---
CROSS_VENDOR_REVIEW_ENABLED=true
# At least two, ideally from different vendors. `uv run crossvet-setup` fills these from the
# models your keys can actually use (model names change; retired names fail at run time).
REVIEW_MODELS=openai:gpt-6.1-sol,anthropic:claude-sonnet-5-5
# with a self-hosted reviewer: ...,ollama:gemma3  or  ...,local:<model-name>
# Model that revises the report after review; pick a vendor NOT on the panel
# (defaults to FINAL_REPORT_MODEL; a warning is added if it shares a vendor with a reviewer)
REVIEW_REVISER_MODEL=
# Context (v1.5): who is asking and why, and a domain pack (seo, marketing, real-estate)
RESEARCH_CONTEXT=
CONTEXT_PACK=
# Support checks (v1.4): a decision model scores whether each quoted passage supports its claim
REVIEW_SUPPORT_CHECKER=
TYPESAFE_API_KEY=
REVIEW_SUPPORT_MODEL=
REVIEW_SUPPORT_MIN_PROB=0.5
# What Jev is asked about: finding (default) or fact (the reviewer's one-sentence statement of what the passage says)
REVIEW_SUPPORT_CLAIM=finding
# Spare reviewers (v1.3): a failed reviewer is replaced by the next spare, preferring a new vendor
REVIEW_FALLBACK_MODELS=
# Seconds before one review call is abandoned and treated as a failure (0 = no limit)
REVIEW_CALL_TIMEOUT=0
# OpenRouter hosting (who serves the model, not which model): hosts to try first, only those, no prompt storage
OPENROUTER_PROVIDER_ORDER=
OPENROUTER_ALLOW_FALLBACKS=
OPENROUTER_DATA_COLLECTION=
# Independent critic checks findings against the research notes before the vote
REVIEW_CRITIC_ENABLED=true
# Deliberation rounds before voting (0 = off, max 3): rotating challengers, grounded position changes only
REVIEW_DELIBERATION_ROUNDS=0
# Blind first pass (v1.2): reviewers outline the answer from the notes before reading the draft
REVIEW_BLIND_PASS_ENABLED=false
REVIEW_BLIND_MAX_POINTS=6
REVIEW_BLIND_MAX_TOKENS=1500
# Early stopping (v1.1): stop on consensus or a stable disagreement, decided in code
REVIEW_DELIBERATION_EARLY_STOP=true
REVIEW_CONSENSUS_THRESHOLD=1.0
REVIEW_DELIBERATION_MIN_ROUNDS=1
REVIEW_CONSENSUS_MIN_GROUNDED_SHARE=0.5
# Optional: append each reviewed run as JSONL (for evals / fine-tuning)
RUN_EXPORT_PATH=

# --- crawlee-server, for `crossvet-scan --crawl` (optional) ---
CRAWLEE_SERVER_URL=
CRAWLEE_SERVER_TOKEN=
# --- Human approval before the final report ---
REQUIRE_APPROVAL=false

# --- Durable runs (CLI) ---
# Default: local SQLite at .crossvet/checkpoints.sqlite
# CROSSVET_CHECKPOINTS=.crossvet/checkpoints.sqlite
# DATABASE_URL=postgresql://user:pass@localhost:5432/crossvet   (uv sync --extra postgres)

# --- Rarely needed ---
# CROSSVET_CACHE_DIR=~/.cache/crossvet          (OpenRouter model catalog cache)
# OPENROUTER_APP_TITLE=Crossvet                 (app name sent to OpenRouter)
# OPENROUTER_APP_URL=https://github.com/j-zulick/crossvet
# TYPESAFE_DEFAULT_MODEL=                       (Jev model when REVIEW_SUPPORT_MODEL is empty; else jev-latest)
# --- Langfuse tracing with cost per model (CLI runs) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   (or your self-hosted URL)

# --- Optional tracing (upstream) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=false

# --- Only for Open Agent Platform deployments (upstream) ---
SUPABASE_KEY=
SUPABASE_URL=
GET_API_KEYS_FROM_CONFIG=false
