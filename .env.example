# Crossvet keys. Copy this file to ~/.config/crossvet/.env (or .env in the folder you run Crossvet from)
# and fill in the keys you have. Every key is optional; one provider is enough. Guide: docs/SETUP.md

# --- Model providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google Gemini (use google:<model>)
GOOGLE_API_KEY=
# xAI Grok (use xai:<model>)
XAI_API_KEY=
# One key for most other vendors (use openrouter:<vendor>/<model>)
OPENROUTER_API_KEY=

# --- Models on your own machine (optional) ---
# Ollama (use ollama:<model>; default address http://localhost:11434/v1)
OLLAMA_BASE_URL=
# Any OpenAI-compatible server: LM Studio, llama.cpp, MLX, vLLM (use local:<model>)
LOCAL_BASE_URL=
LOCAL_API_KEY=

# --- Crossvet ---
# Settings file (empty = ./crossvet.toml, else ~/.config/crossvet/crossvet.toml, else built in)
CROSSVET_CONFIG=
# The log of every turn (empty = ~/.local/share/crossvet/chat.db)
CROSSVET_DB=
# Token the server requires as Authorization: Bearer <token>; needed (16+ characters) to listen beyond this computer
CROSSVET_TOKEN=
